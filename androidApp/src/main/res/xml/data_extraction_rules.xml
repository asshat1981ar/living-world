<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules: the downloaded model stays on the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
